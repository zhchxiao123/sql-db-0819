#!/usr/bin/make
#
#### The suffix to add to executable files.  ".exe" for windows.
#    Nothing for unix.
#
E =

#### C Compile and options for use in building executables that 
#    will run on the target platform.
#
CC = gcc -g -Wall -Os
#CC = gcc -g -Wall -DOMIT_ODBC=1 -fprofile-arcs -ftest-coverage
#CC += -DSQLITE_COVERAGE_TEST
# Built-in SQLite and ODBC engines are compiled out: the sql-db-0819 runner
# only registers the subprocess engine (see PIN.txt).  OMIT_SQLITE also lets
# the vendored tree drop sqlite3.c, whose amalgamation trips secret scanners
# on benign C expressions (e.g. Key->default_rc, api->soft_heap_limit64).
CC += -DSQLITE_NO_SYNC=1 -DOMIT_ODBC=1 -DOMIT_SQLITE=1

#### Extra arguments for linking the finished binary. 
#
LIB = $(LDFLAGS)

# You should not need to change anything below this line
###############################################################################
#
OBJ = \
  md5.o

INC = \
  slt_subprocess.c

OPTS += -DSQLITE_THREADSAFE=0
OPTS += -DSQLITE_DEBUG

sqllogictest$(E):	sqllogictest.c sqllogictest.h $(OBJ) $(INC)
	$(CC) $(CFLAGS) -o sqllogictest$(E) sqllogictest.c $(OBJ)

md5.o:	md5.c
	$(CC) $(CFLAGS) -c md5.c

clean:
	rm -f $(OBJ)
